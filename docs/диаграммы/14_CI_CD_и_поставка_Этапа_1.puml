@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
actor "Разработчик" as Dev
rectangle "feature/*" as Feature
rectangle "develop" as Develop
rectangle "CI
php -l + smoke" as CI
rectangle "main" as Main
rectangle "Staging / портал приемки" as Stage
rectangle "Заказчик" as Client
Dev --> Feature
Feature --> Develop : pull request
Develop --> CI
CI --> Main : после review/приемки
Main --> Stage : deployment
Stage --> Client : документация / прототипы / чек-лист
@enduml
